    if(activeFilter==='9(3)-goods' && !(r.sec==='9(3)' && r.cat==='goods')) return false;
  }
  if(searchTerm){
    const t=searchTerm.toLowerCase();
    const hay=(r.name+' '+r.code+' '+r.notif+' '+r.note).toLowerCase();
    if(!hay.includes(t)) return false;
  }
  return true;
}

