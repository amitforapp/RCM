  const filtered = RCM.filter(matches);
  const out = document.getElementById('output');
  document.getElementById('resultCount').textContent = filtered.length + ' of ' + RCM.length + ' RCM entries shown — click any row to expand full details';
  if(filtered.length===0){
    out.innerHTML = `<div class="empty">No RCM entries match your search/filter. Try clearing the search box.</div>`;
    updateStats();
    return;
  }
  const order = ['9(3)','9(4)','9(5)'];
  let html='';
  order.forEach(sec=>{
    const items = filtered.filter(r=>r.sec===sec);
    if(items.length===0) return;
    const gl = groupLabel(sec);
    html += `<div class="sec-head"><h3>${gl.t}</h3><span class="cnt">${items.length}</span></div>
             <div class="sec-desc">${gl.d}</div>
             <div class="tbl-wrap"><table class="rcm-table">
               <thead><tr>
                 <th class="num">#</th><th>Service / Goods</th><th class="sec-col">Section</th><th>Type</th>
                 <th class="rate-col">GST Rate</th><th class="code-col">HSN / SAC</th><th class="exp-col"></th>
               </tr></thead>
               <tbody>${items.map((r,i)=>tableRow(r,i+1)).join('')}</tbody>
             </table></div>`;
  });
  out.innerHTML = html;
  updateStats();
}

function updateStats(){
  const activeEntries = RCM.filter(r=>!r.withdrawn);
  const s93 = activeEntries.filter(r=>r.sec==='9(3)').length;
  const s94 = activeEntries.filter(r=>r.sec==='9(4)').length;
  const s95 = activeEntries.filter(r=>r.sec==='9(5)').length;
  const withdrawn = RCM.filter(r=>r.withdrawn).length;
  document.getElementById('statGrid').innerHTML = `
    <div class="sc blue" onclick="setFilterFromStat('all')"><div class="sc-lbl">Total RCM entries</div><div class="sc-val">${RCM.length}</div><div class="sc-sub">Services, goods &amp; e-comm combined</div></div>
    <div class="sc green" onclick="setFilterFromStat('9(3)-services')"><div class="sc-lbl">§9(3) services</div><div class="sc-val">${activeEntries.filter(r=>r.sec==='9(3)'&&r.cat==='services').length}</div><div class="sc-sub">Regardless of supplier registration</div></div>
    <div class="sc green" onclick="setFilterFromStat('9(3)-goods')"><div class="sc-lbl">§9(3) goods</div><div class="sc-val">${activeEntries.filter(r=>r.sec==='9(3)'&&r.cat==='goods').length}</div><div class="sc-sub">Cashew, tobacco, cotton, silk, PSLC…</div></div>
    <div class="sc gold" onclick="setFilterFromStat('9(4)')"><div class="sc-lbl">§9(4) unregistered-supplier</div><div class="sc-val">${s94}</div><div class="sc-sub">Metal scrap, real estate, cement</div></div>
    <div class="sc purple" onclick="setFilterFromStat('9(5)')"><div class="sc-lbl">§9(5) e-commerce</div><div class="sc-val">${s95}</div><div class="sc-sub">Cab, accommodation, food delivery</div></div>
    <div class="sc rose" onclick="setStatus('all')"><div class="sc-lbl">Withdrawn entries</div><div class="sc-val">${withdrawn}</div><div class="sc-sub">Now on forward charge</div></div>
  `;
}

buildTabs();
render();
buildCalcDropdown();

function doLogin(){
  const u = document.getElementById('loginUser').value.trim();
  const p = document.getElementById('loginPass').value;
  const err = document.getElementById('loginErr');
  if(u === 'Smart' && p === 'SmartAI'){
    err.style.display='none';
    document.getElementById('login-screen').style.display='none';
    document.getElementById('app-screen').style.display='block';
  } else {
    err.style.display='block';
  }
}

function doLogout(){
  document.getElementById('app-screen').style.display='none';
  document.getElementById('login-screen').style.display='flex';
  switchTab('reference');
}

// ══════════════════════ TABS ══════════════════════
function switchTab(name){
  document.getElementById('tab-reference').style.display = (name==='reference') ? 'block' : 'none';
  document.getElementById('tab-calculator').style.display = (name==='calculator') ? 'block' : 'none';
  document.getElementById('tabbtn-reference').classList.toggle('active', name==='reference');
  document.getElementById('tabbtn-calculator').classList.toggle('active', name==='calculator');
}

// ══════════════════════ RCM CALCULATOR ══════════════════════

function buildCalcDropdown(){
  const sel = document.getElementById('calcCategory');
  const order = ['9(3)','9(4)','9(5)'];
  let html = '';
  order.forEach(sec=>{
    const items = RCM.filter(r=>r.sec===sec && !r.withdrawn);
    if(items.length===0) return;
    const gl = groupLabel(sec);
    html += `<optgroup label="${gl.t.replace('Section ','§')}">`;
    items.forEach(r=>{
      html += `<option value="${r._id}">[§${r.sec}] ${r.name} (${r.rate}) — ${r.code}</option>`;
    });
    html += `</optgroup>`;
  });
  sel.innerHTML = html;
  onCalcCategoryChange();
}

function parseRatePercent(rateStr){
  const m = rateStr.match(/(\d+(\.\d+)?)\s*%/);
  return m ? parseFloat(m[1]) : null;
}
function rateIsVariable(rateStr){
  return /\/|typically|varies|applicable|as per|per declared/i.test(rateStr);
}

function onCalcCategoryChange(){
  const sel = document.getElementById('calcCategory');
  const r = RCM.find(x=>x._id===sel.value);
  const isIgstOnly = r && r.rateType === 'IGST';
  document.getElementById('stbtn-intra').disabled = !!isIgstOnly;
  document.getElementById('stbtn-intra').style.opacity = isIgstOnly ? '0.4' : '1';
  document.getElementById('stbtn-intra').style.cursor = isIgstOnly ? 'not-allowed' : 'pointer';
  if(isIgstOnly){ calcSupply = 'inter'; }
  document.getElementById('stbtn-intra').classList.toggle('active', calcSupply==='intra');
  document.getElementById('stbtn-inter').classList.toggle('active', calcSupply==='inter');
  computeCalc();
}

function setSupplyType(type){
  const sel = document.getElementById('calcCategory');
  const r = RCM.find(x=>x._id===sel.value);
  if(r && r.rateType==='IGST' && type==='intra') return; // import of services is always IGST
  calcSupply = type;
  document.getElementById('stbtn-intra').classList.toggle('active', calcSupply==='intra');
  document.getElementById('stbtn-inter').classList.toggle('active', calcSupply==='inter');
  computeCalc();
}

function computeCalc(){
  const sel = document.getElementById('calcCategory');
  const r = RCM.find(x=>x._id===sel.value);
  if(!r) return;
  const amount = parseFloat(document.getElementById('calcAmount').value) || 0;
  const rate = parseRatePercent(r.rate);
  const variable = rateIsVariable(r.rate);

  // Category info box
  document.getElementById('calcCatInfo').innerHTML = `
    <span class="cc-rate-badge">Rate: ${r.rate}</span>
    <div class="cc-name">Category: ${r.name}</div>
    <div class="cc-meta">Notification: ${r.notif} | HSN/SAC: ${r.code}</div>
  `;

  const resultBox = document.getElementById('calcResult');
  if(rate===null){
    resultBox.innerHTML = `
      <div class="cr-title">💲 Tax computation breakdown</div>
      <div class="calc-note warn"><b>Rate not fixed:</b> This category's GST rate depends on the HSN/SAC classification of the specific goods/service involved (see notes on the Reference tab), so it can't be auto-computed here. Identify the applicable rate for your specific item, then use a numeric-rate category or apply that rate manually to the invoice value of ₹${amount.toLocaleString('en-IN')}.</div>
    `;
    return;
  }

  let cgst=0, sgst=0, igst=0, total=0;
  if(calcSupply==='intra'){
    cgst = amount * rate / 2 / 100;
    sgst = amount * rate / 2 / 100;
    total = cgst + sgst;
  } else {
    igst = amount * rate / 100;
    total = igst;
  }

  let breakdownHtml = '';
  if(calcSupply==='intra'){
    breakdownHtml = `
      <div class="cr-box"><div class="cr-lbl">CGST (${(rate/2)}%)</div><div class="cr-val">₹${cgst.toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2})}</div></div>
      <div class="cr-box"><div class="cr-lbl">SGST (${(rate/2)}%)</div><div class="cr-val">₹${sgst.toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2})}</div></div>
      <div class="cr-box total"><div class="cr-lbl">Total tax payable</div><div class="cr-val">₹${total.toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2})}</div></div>
    `;
  } else {
    breakdownHtml = `
      <div class="cr-box"><div class="cr-lbl">IGST (${rate}%)</div><div class="cr-val">₹${igst.toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2})}</div></div>
      <div class="cr-box total"><div class="cr-lbl">Total tax payable</div><div class="cr-val">₹${total.toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2})}</div></div>
    `;
  }

  let itcNote = '';
  if(r.itc===true){
    itcNote = `<div class="calc-note ok"><b>✓ ITC availability:</b> Fully eligible for ITC claim in the same period's return (subject to the supply being used for business purposes), once the RCM tax is paid in cash.</div>`;
  } else if(r.itc===false){
    itcNote = `<div class="calc-note blocked"><b>✗ ITC availability:</b> Not available to the recipient for this category (see the Reference tab entry for the specific statutory reason — e.g. a Section 17(5) block).</div>`;
  } else {
    itcNote = `<div class="calc-note warn"><b>⚠ ITC availability:</b> Conditional — depends on specific facts (e.g. threshold computations, related-party valuation, or promoter-specific rules). Refer to the full note on the Reference tab.</div>`;
  }

  const variableNote = variable ? `<div class="calc-note warn"><b>Note:</b> The rate shown (${r.rate}) may vary by sub-case — this calculation uses the first applicable percentage (${rate}%). Confirm against the specific fact pattern before relying on this figure.</div>` : '';
  const withdrawnNote = r.withdrawn ? `<div class="calc-note blocked"><b>🚫 Withdrawn:</b> This category was withdrawn from RCM effective ${r.withdrawn} and now falls under forward charge — this calculation is for historical reference only.</div>` : '';

  resultBox.innerHTML = `
    <div class="cr-title">💲 Tax computation breakdown</div>
    <div class="cr-grid">${breakdownHtml}</div>
    <div class="calc-note"><b>Mandatory cash payment:</b> RCM tax of ₹${total.toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2})} must be paid electronically in cash via GSTR-3B Table 3.1(d). You cannot use existing Input Tax Credit (ITC) to discharge this RCM liability.</div>
    ${itcNote}
    ${variableNote}
    ${withdrawnNote}
  `;
}
</script>
</div>
